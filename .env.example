# EduVerse AI Configuration

# Mistral 7B Cloud API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=open-mistral-7b
# Fallback models: mistral-tiny, mistral-small-latest

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLite Database
DATABASE_URL=sqlite:///./eduverse.db

# JWT Secret for Demo Authentication
JWT_SECRET=eduverse_super_secret_jwt_key_hackathon_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
